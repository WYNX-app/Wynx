{
  "name": "wynx-app",
  "productName": "WYNX",
  "version": "1.0.0",
  "description": "WYNX — Gestão Inteligente de Estoque",
  "author": "WYNX (Heitor, Enzo, Lara)",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && electron .\"",
    "start": "vite",
    "build:ui": "vite build",
    "build": "vite build && electron-builder --win portable",
    "build:installer": "vite build && electron-builder --win nsis portable"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "@tailwindcss/vite": "^4.3.3",
    "lucide-react": "^1.56.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^2.15.4",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.1.0",
    "electron": "^44.7.1",
    "electron-builder": "^26.15.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "br.com.wynx.estoque",
    "productName": "WYNX",
    "copyright": "Copyright © 2026 WYNX",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets"
      }
    ],
    "win": {
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "WYNX-Gestao-de-Estoque.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "WYNX-Instalador.exe"
    }
  }
}
